# =============================================================================
# .env.exemple — MODELE de fichier de variables d'environnement
# -----------------------------------------------------------------------------
# Unique surface de configuration à l'exécution : les modules `config.py`
# (préfixe DECROCHAGE_L1_) et `serving/settings.py` (préfixe DECROCHAGE_) lisent
# ce fichier — on n'édite pas le code pour régler le projet.
#
# Copier en `.env`, puis renseigner DECROCHAGE_API_KEYS. Toutes les autres
# variables sont OPTIONNELLES : décommentées ci-dessous, elles montrent la valeur
# par défaut ; laissées commentées, c'est ce défaut qui s'applique.
# =============================================================================

# --- Chemins d'exécution (DECROCHAGE_L1_*) -----------------------------------
# Racine dont dérivent data/, artifacts/, reports/… Déduite du package par défaut
# (le projet vise les mêmes fichiers depuis notebooks/ ou la racine). À surcharger
# seulement pour pointer un autre jeu de dossiers (ex. essai jetable).
# DECROCHAGE_L1_ROOT_DIR=/tmp/essai

# --- Service d'inférence (DECROCHAGE_*) --------------------------------------
# `docker compose --env-file .env …` ou `uvicorn decrochage_l1.serving.api:app`.
# Aucune valeur n'est un secret par défaut : sans DECROCHAGE_API_KEYS, les routes
# protégées répondent 503 (une clé connue par défaut ne serait pas un contrôle).

# Clés d'API autorisées, séparées par des virgules. OBLIGATOIRE pour les routes protégées.
DECROCHAGE_API_KEYS=change-me

# Exposer l'indicateur binaire « Risque / Non » en plus de la probabilité (sinon probabilité
# seule, sans verdict binaire — la décision reste à l'équipe, art. 22). Le seuil (ci-dessous) et
# le paramètre ?capacite= ne gouvernent que cet indicateur : hors régime, refusés (422). Défaut : false.
# DECROCHAGE_EXPOSER_INDICATEUR=false

# Origines autorisées pour l'appel navigateur (client de démonstration). Défaut : http://localhost:8080.
# DECROCHAGE_CORS_ORIGINS=http://localhost:8080

# Exposer l'endpoint /metrics (Prometheus). Défaut : true.
# DECROCHAGE_MONITORING_ACTIF=true

# Surcharge du seuil de décision (régime indicateur). Absent -> celui de la fiche (~0,42).
# DECROCHAGE_SEUIL_DEFAUT=0.30

# Bornes de dérive (PSI) qui qualifient un lot lors d'un scoring de campagne (derive=true).
# Absentes -> celles de la fiche (surveillance=0.10, alerte=0.25, effectif_min=200).
# Contrainte : surveillance <= alerte, effectif_min > 0.
# DECROCHAGE_DRIFT_SURVEILLANCE=0.10
# DECROCHAGE_DRIFT_ALERTE=0.25
# DECROCHAGE_DRIFT_EFFECTIF_MIN=200

# --- Tableau de bord Grafana (démonstration) ---------------------------------
# Accès admin du conteneur Grafana. Défaut : admin / admin.
# GRAFANA_UTILISATEUR=admin
# GRAFANA_MOT_DE_PASSE=admin
