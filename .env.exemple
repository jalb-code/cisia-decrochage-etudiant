# =============================================================================
# .env.exemple — MODELE de fichier de variables d'environnement
# =============================================================================

# --- Service d'inférence (docker compose --env-file .env) ---------------------
# Aucune valeur n'est un secret par défaut : sans DECROCHAGE_API_KEYS, les routes
# protégées répondent 503 (une clé connue par défaut ne serait pas un contrôle).

# Clés d'API autorisées, séparées par des virgules. Obligatoire pour les routes protégées.
DECROCHAGE_API_KEYS=change-me

# Exposer l'indicateur « Risque / Non » en plus de la probabilité (sinon probabilité seule).
DECROCHAGE_EXPOSER_INDICATEUR=false

# Origines autorisées pour l'appel navigateur (client de démonstration).
DECROCHAGE_CORS_ORIGINS=http://localhost:8080

# Surcharge du seuil de décision. Absent -> celui de la fiche du modèle déployé.
# DECROCHAGE_SEUIL_DEFAUT=0.16

# Bornes de dérive (PSI) qui qualifient un lot lors d'un scoring de campagne (derive=true).
# Absentes -> celles de la fiche (surveillance=0.10, alerte=0.25, effectif_min=200).
# Contrainte : surveillance <= alerte, effectif_min > 0.
# DECROCHAGE_DRIFT_SURVEILLANCE=0.10
# DECROCHAGE_DRIFT_ALERTE=0.25
# DECROCHAGE_DRIFT_EFFECTIF_MIN=200

# Accès au tableau de bord Grafana (démonstration).
GRAFANA_UTILISATEUR=admin
GRAFANA_MOT_DE_PASSE=admin
